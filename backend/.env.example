PORT=5000
MONGODB_URI=mongodb://localhost:27017/algonix
JWT_SECRET=your_jwt_secret_key_here
GLOT_TOKEN=your_glot_token_here
GLOT_API_TOKEN=your_glot_api_token_here
GLOT_API_URL=https://glot.io/api/run
PISTON_URL=https://emkc.org/api/v2/piston/execute
# If you use Glot, set GLOT_API_TOKEN and leave PISTON_URL unused.
# Default Piston execution endpoint is now whitelist-only and may be blocked.
# JUDGE0_URL and RAPIDAPI_KEY are no longer needed
NODE_ENV=development
FRONTEND_URL=http://localhost:3000